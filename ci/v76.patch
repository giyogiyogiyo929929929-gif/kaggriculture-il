+# ---- EXP: stable empty-slot compaction after v28 ----
+_V30_PARENT = agent
+_V30_REPORT = dict(reordered_turns=0, estimated_gain=0.0, evaluations=0, errors=0)
+
+def _v30_candidates_block(block):
+    sells = [list(o) for o in block if o and o[0] == 'SELL']
+    if not sells or len(sells) == len(block):
+        return
+    # Preserve the sell order selected by v28; only choose timing slots.
+    for pos in _v27_it.combinations(range(len(block)), len(sells)):
+        out = [[] for _ in block]
+        for i, order in zip(pos, sells): out[i] = order
+        yield out
+
+def _v30_compact(observation, action):
+    market = action.get('market') or []
+    if len(market) < 2 or not any(not o for o in market):
+        return action
+    orders = [list(o) if isinstance(o,(list,tuple)) else o for o in market]
+    params = _v44y_params(observation)
+    stock = {k:max(0,int(v)) for k,v in projected_shed(action,FarmView(observation)).items()}
+    inv = {k:int(v) for k,v in observation['market']['inventory'].items()}
+    # Opponent model is the pre-compaction v28 schedule.
+    factor = _v44y_factor_margin(orders, inv, stock, params)
+    base = best = factor(orders); best_orders = None
+    i=0; evaluations=0
+    while i < len(orders):
+        if not (not orders[i] or (orders[i] and orders[i][0]=='SELL')):
+            i += 1; continue
+        j=i
+        while j < len(orders) and (not orders[j] or (orders[j] and orders[j][0]=='SELL')):
+            j += 1
+        block=orders[i:j]
+        if any(not o for o in block) and any(o and o[0]=='SELL' for o in block):
+            for cand_block in _v30_candidates_block(block):
+                cand = orders[:i] + cand_block + orders[j:]
+                if cand == orders: continue
+                evaluations += 1
+                value = factor(cand)
+                if value > best + 0.5:
+                    best, best_orders = value, cand
+        if best_orders is not None:
+            orders = best_orders; best_orders = None
+        i=j
+    _V30_REPORT['evaluations'] += evaluations
+    if best <= base + 0.5:
+        return action
+    _V30_REPORT['reordered_turns'] += 1; _V30_REPORT['estimated_gain'] += best-base
+    return dict(action, market=orders)
+
+def agent(observation, configuration=None):
+    action = _V30_PARENT(observation, configuration)
+    try:
+        if int(observation.get('step',0)) == 0:
+            _V30_REPORT.update(reordered_turns=0,estimated_gain=0.0,evaluations=0,errors=0)
+        return _v30_compact(observation, action)
+    except Exception:
+        _V30_REPORT['errors'] += 1
+        return action
+agent.telemetry = _V30_REPORT
